rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Único super admin de la plataforma. Se identifica por el email de la
    // cuenta (lo firma Firebase Auth), no por el campo `role` del documento:
    // ese campo lo podía escribir cualquiera al crear su propio perfil.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@shinracity.com';
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function ownsCommerce(commerceId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/commerces/$(commerceId)).data.ownerId == request.auth.uid;
    }

    // Campos del perfil que el usuario no puede tocar: los maneja el admin.
    // Los puntos solo se suman por la vía de couponPointsClaim (abajo).
    function protectedUserFields() {
      return ['role', 'isActive', 'isSuspended', 'isVerified', 'totalPoints', 'level',
              'totalCouponsRedeemed', 'totalSavings', 'badgeIds', 'achievementIds',
              'lastPointsCouponId'];
    }

    // Puntos por cupón canjeado (AppConstants.pointsPerCouponRedeemed)
    function couponPoints() {
      return 10;
    }

    // Igual que AppConstants.levelThresholds
    function levelFor(points) {
      return points >= 15000 ? 'lifetime'
           : points >= 5000 ? 'ambassador'
           : points >= 2000 ? 'exemplary'
           : points >= 500 ? 'frequent'
           : 'explorer';
    }

    function pointsTxPath(couponId) {
      return /databases/$(database)/documents/points_transactions/$('coupon_' + couponId);
    }

    // Cobrar los puntos de un cupón: el cupón es del usuario, el comercio ya lo
    // canjeó ('used'), y se crea en la misma escritura el movimiento
    // points_transactions/coupon_{id}, que no existía. Como ese movimiento no
    // se puede borrar ni editar, cada cupón paga una sola vez.
    function couponPointsClaim(userId) {
      let couponId = request.resource.data.lastPointsCouponId;
      let coupon = get(/databases/$(database)/documents/coupons/$(couponId)).data;
      let total = resource.data.get('totalPoints', 0) + couponPoints();
      return changed().hasOnly(['totalPoints', 'availablePoints', 'level', 'totalCouponsRedeemed',
                                'lastPointsCouponId', 'updatedAt'])
          && coupon.userId == userId
          && coupon.status == 'used'
          && !exists(pointsTxPath(couponId))
          && existsAfter(pointsTxPath(couponId))
          && request.resource.data.totalPoints == total
          && request.resource.data.availablePoints == resource.data.get('availablePoints', 0) + couponPoints()
          && request.resource.data.totalCouponsRedeemed == resource.data.get('totalCouponsRedeemed', 0) + 1
          && request.resource.data.level == levelFor(total);
    }

    // Users
    match /users/{userId} {
      allow read: if isCurrentUser(userId) || isAdmin();
      // un perfil nuevo nace sin puntos ni verificación; 'businessOwner' no da
      // permisos (todo se decide por ser dueño del comercio)
      allow create: if isCurrentUser(userId)
                    && request.resource.data.get('role', 'user') in ['user', 'businessOwner']
                    && request.resource.data.get('totalPoints', 0) == 0
                    && request.resource.data.get('availablePoints', 0) == 0
                    && request.resource.data.get('totalCouponsRedeemed', 0) == 0
                    && request.resource.data.get('level', 'explorer') == 'explorer'
                    && request.resource.data.get('isVerified', false) == false;
      allow update: if isAdmin()
                    || (isCurrentUser(userId)
                        && !changed().hasAny(protectedUserFields())
                        // availablePoints solo puede bajar (canje de recompensas)
                        && (!changed().hasAny(['availablePoints'])
                            || request.resource.data.availablePoints < resource.data.availablePoints))
                    || (isCurrentUser(userId) && couponPointsClaim(userId))
                    // al registrar su comercio, el usuario pasa de 'user' a 'businessOwner' (y nada más)
                    || (isCurrentUser(userId)
                        && changed().hasOnly(['role', 'updatedAt'])
                        && resource.data.role == 'user'
                        && request.resource.data.role == 'businessOwner');
      allow delete: if isCurrentUser(userId) || isAdmin();
    }

    // Perfil público (ranking y lista de empleados): sin email ni datos
    // privados. Los puntos y el nivel tienen que coincidir con el perfil real.
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin()
                    || (isCurrentUser(userId)
                        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'totalPoints',
                                                                  'level', 'achievementCount', 'updatedAt'])
                        && request.resource.data.totalPoints
                           == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('totalPoints', 0)
                        && request.resource.data.level
                           == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('level', 'explorer'));
      allow delete: if isCurrentUser(userId) || isAdmin();
    }

    // email (en minúsculas) -> uid, para que un comercio agregue empleados.
    // Solo se puede leer conociendo el email exacto; no se puede listar.
    match /user_emails/{email} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create, update: if isAuthenticated()
                    && request.auth.token.email != null
                    && email == request.auth.token.email.lower()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Commerces
    match /commerces/{commerceId} {
      allow read: if true;
      // nadie puede crear un comercio a nombre de otro
      allow create: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.ownerId == request.auth.uid
                        // verificado / destacado / plan pago solo los pone el admin
                        && request.resource.data.get('isVerified', false) == false
                        && request.resource.data.get('isFeatured', false) == false
                        && request.resource.data.get('plan', 'free') == 'free');
      allow update: if isAdmin()
                    || (ownsCommerce(commerceId) && !changed().hasAny(['ownerId', 'isVerified', 'isFeatured', 'plan']))
                    // seguir / dejar de seguir: solo el contador, de a uno
                    || (isAuthenticated()
                        && changed().hasOnly(['followerCount'])
                        && (request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
                            || request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1));
      allow delete: if isAdmin();
    }

    // Promotions
    match /promotions/{promotionId} {
      allow read: if true;
      // solo para un comercio propio
      allow create: if isAdmin() || ownsCommerce(request.resource.data.commerceId);
      allow update: if isAdmin()
                    || (ownsCommerce(resource.data.commerceId) && !changed().hasAny(['commerceId']))
                    // reclamar un cupón suma de a un cupo, sin pasar el total
                    || (isAuthenticated()
                        && changed().hasOnly(['usedSlots'])
                        && request.resource.data.usedSlots == resource.data.get('usedSlots', 0) + 1
                        && (resource.data.get('totalSlots', null) == null
                            || request.resource.data.usedSlots <= resource.data.totalSlots));
      allow delete: if isAdmin() || ownsCommerce(resource.data.commerceId);
    }

    // Coupons — el usuario reclama los suyos; el comercio los canjea
    match /coupons/{couponId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin() || ownsCommerce(resource.data.commerceId));
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'available'
                    && request.resource.data.keys().hasAll(['userId', 'promotionId', 'commerceId', 'status'])
                    && get(/databases/$(database)/documents/promotions/$(request.resource.data.promotionId)).data.commerceId
                       == request.resource.data.commerceId;
      allow update: if isAdmin()
                    // el dueño del cupón puede cancelarlo, no canjearlo
                    || (resource.data.userId == request.auth.uid
                        && changed().hasOnly(['status', 'updatedAt', 'cancelledAt', 'cancelReason'])
                        && request.resource.data.status == 'cancelled')
                    // el comercio canjea los cupones de sus promociones
                    || (ownsCommerce(resource.data.commerceId)
                        && !changed().hasAny(['userId', 'promotionId', 'commerceId']));
      allow delete: if isAdmin();
    }

    // Notifications (root collection — legacy)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User notifications subcollection (read by app)
    match /users/{userId}/notifications/{notId} {
      allow read, delete: if isCurrentUser(userId) || isAdmin();
      allow update: if isCurrentUser(userId) || isAdmin();
      allow create: if isAdmin();
    }

    // Reviews — firmadas siempre por quien las escribe
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid
                        && !changed().hasAny(['userId', 'commerceId', 'helpfulCount']))
                    // "me resultó útil": cualquiera suma de a uno
                    || (isAuthenticated()
                        && changed().hasOnly(['helpfulCount'])
                        && request.resource.data.helpfulCount == resource.data.get('helpfulCount', 0) + 1);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Rewards
    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || ownsCommerce(request.resource.data.commerceId);
      allow update: if isAdmin()
                    || ownsCommerce(resource.data.commerceId)
                    // canjear: suma de a uno el contador
                    || (isAuthenticated()
                        && changed().hasOnly(['redeemedCount'])
                        && request.resource.data.redeemedCount == resource.data.get('redeemedCount', 0) + 1);
      allow delete: if isAdmin();
    }

    // Achievements definitions (public read)
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Points transactions — el usuario solo registra gastos (puntos < 0) o el
    // cobro de un cupón canjeado (coupon_{id}, ver couponPointsClaim)
    match /points_transactions/{txId} {
      // get de un id inexistente: la app lo consulta antes de cobrar un cupón
      allow get: if isAuthenticated()
                 && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin()
                    || (isAuthenticated()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.points is int
                        && request.resource.data.points < 0)
                    || (isAuthenticated()
                        && request.resource.data.userId == request.auth.uid
                        && txId == 'coupon_' + request.resource.data.couponId
                        && request.resource.data.points == couponPoints()
                        && request.resource.data.type == 'earned'
                        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPointsCouponId
                           == request.resource.data.couponId);
      allow update, delete: if isAdmin();
    }

    // Reward redemptions
    match /reward_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'rewardId', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Payment logs (admin only; los escribirían las Cloud Functions)
    match /payment_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Coupon redemptions
    match /coupon_redemptions/{redemptionId} {
      allow read: if isAuthenticated()
                  && (resource.data.get('userId', '') == request.auth.uid || isAdmin()
                      || ownsCommerce(resource.data.get('commerceId', '')));
      allow create: if isAuthenticated()
                    && (isAdmin() || ownsCommerce(request.resource.data.commerceId));
      allow update, delete: if isAdmin();
    }

    // Config (plans, settings) - admin read/write; los precios de los planes
    // los ve cualquier comercio (pantalla "Mejorar plan")
    match /config/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && docId == 'plans');
      allow write: if isAdmin();
    }

    // Herramientas del panel de admin
    match /audit_logs/{docId} {
      allow read, write: if isAdmin();
    }
    match /fraud_flags/{docId} {
      allow read, write: if isAdmin();
    }
    match /moderation_queue/{docId} {
      allow read, write: if isAdmin();
    }

    // Analytics (write only via CF)
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
